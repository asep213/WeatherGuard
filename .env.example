# ============================================================
# WeatherGuard AI - Environment Configuration Template
# ============================================================

# --- Application Environment ---
APP_NAME=WeatherGuard AI
APP_ENV=development
SECRET_KEY=change-this-super-secret-key-in-production-2026
LOG_LEVEL=INFO
API_V1_STR=/api/v1
CORS_ORIGINS=http://localhost:8501

# --- Next.js frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Supabase is optional until authentication or persistent user data is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=8501

# --- PostgreSQL / TimescaleDB with PostGIS ---
POSTGRES_USER=weatherguard_admin
POSTGRES_PASSWORD=WeatherGuardSecure2026!
POSTGRES_DB=weatherguard_db
POSTGRES_HOST=weatherguard-db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://weatherguard_admin:WeatherGuardSecure2026!@weatherguard-db:5432/weatherguard_db

# --- Redis Broker & Cache ---
REDIS_URL=redis://weatherguard-redis:6379/0

# --- External API Keys ---
OPENWEATHER_API_KEY=mock_openweather_api_key_replace_with_real_one
BMKG_API_TOKEN=mock_bmkg_partner_token_if_available
NASA_EARTHDATA_TOKEN=mock_nasa_earthdata_token

# --- AI Model Inference Settings ---
INFERENCE_DEVICE=cpu # 'cuda' for NVIDIA GPU, 'cpu' for fallback
AI_MODEL_BACKBONE=PRITHVI_WXC_SURYA # PRITHVI_WXC_SURYA or NVIDIA_EARTH2
GRID_RESOLUTION_KM=5.0
FORECAST_HORIZON_DAYS=7
